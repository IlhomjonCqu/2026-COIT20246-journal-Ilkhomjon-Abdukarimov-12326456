        <!-- ICMP Explanation -->
        <mxCell id="36" value="&lt;b&gt;First Two ICMP Packets Explained:&lt;/b&gt;&#xa;&#xa;&lt;b&gt;Packet 1 — ICMP Echo Request&lt;/b&gt;&#xa;Sent by: Windows Host (192.168.56.1)&#xa;Sent to: OpenWRT VM (192.168.56.2)&#xa;Type: 8, Code: 0&#xa;Purpose: Tests reachability — asks OpenWRT to reply.&#xa;&#xa;&lt;b&gt;Packet 2 — ICMP Echo Reply&lt;/b&gt;&#xa;Sent by: OpenWRT VM (192.168.56.2)&#xa;Sent to: Windows Host (192.168.56.1)&#xa;Type: 0, Code: 0&#xa;Purpose: Confirms the host is reachable &amp; measures RTT." style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=top;whiteSpace=wrap;rounded=4;fontSize=11;spacingLeft=10;spacingTop=8;spacingBottom=8;" vertex="1" parent="1">

        <mxCell id="2" value="Week 5 Task 3d — ICMP/IP Packet Captured at Router A" style="text;html=1;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1"><mxGeometry x="160" y="20" width="850" height="40" as="geometry" /></mxCell><mxCell id="3" value="Scenario: PC1 (64.56.0.2) sends an ICMP Echo Request to PC4 (10.20.0.2). Captured at Router A LAN interface eth0." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="80" width="1040" height="70" as="geometry" /></mxCell><mxCell id="4" value="Ethernet frame at Router A LAN interface" style="text;html=1;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1"><mxGeometry x="70" y="160" width="1040" height="35" as="geometry" /></mxCell><mxCell id="e0" value="Destination MAC&lt;br&gt;Router A eth0 MAC&lt;br&gt;6 bytes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="210" width="240" height="80" as="geometry" /></mxCell><mxCell id="e1" value="Source MAC&lt;br&gt;PC1 NIC MAC&lt;br&gt;6 bytes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="210" width="190" height="80" as="geometry" /></mxCell><mxCell id="e2" value="EtherType&lt;br&gt;0x0800 IPv4&lt;br&gt;2 bytes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="520" y="210" width="160" height="80" as="geometry" /></mxCell><mxCell id="e3" value="IPv4 Header + ICMP Echo Request + Data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="210" width="450" height="80" as="geometry" /></mxCell><mxCell id="5" value="IPv4 packet — end-to-end addresses remain PC1 → PC4" style="text;html=1;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1"><mxGeometry x="70" y="320" width="1040" height="35" as="geometry" /></mxCell><mxCell id="ip0" value="Source IP&lt;br&gt;64.56.0.2&lt;br&gt;PC1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="370" width="190" height="80" as="geometry" /></mxCell><mxCell id="ip1" value="Destination IP&lt;br&gt;10.20.0.2&lt;br&gt;PC4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="270" y="370" width="190" height="80" as="geometry" /></mxCell><mxCell id="ip2" value="Protocol&lt;br&gt;ICMP (1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="370" width="140" height="80" as="geometry" /></mxCell><mxCell id="ip3" value="TTL&lt;br&gt;128 before routing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="620" y="370" width="160" height="80" as="geometry" /></mxCell><mxCell id="ip4" value="IP payload: ICMP Echo Request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="790" y="370" width="330" height="80" as="geometry" /></mxCell><mxCell id="6" value="ICMP Echo Request" style="text;html=1;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1"><mxGeometry x="70" y="480" width="1040" height="35" as="geometry" /></mxCell><mxCell id="icmp0" value="Type 8&lt;br&gt;Echo Request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="530" width="150" height="75" as="geometry" /></mxCell><mxCell id="icmp1" value="Code 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230" y="530" width="110" height="75" as="geometry" /></mxCell><mxCell id="icmp2" value="Checksum" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="530" width="150" height="75" as="geometry" /></mxCell><mxCell id="icmp3" value="Identifier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="510" y="530" width="150" height="75" as="geometry" /></mxCell><mxCell id="icmp4" value="Sequence No. 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="670" y="530" width="150" height="75" as="geometry" /></mxCell><mxCell id="icmp5" value="Data / ping payload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="830" y="530" width="320" height="75" as="geometry" /></mxCell><mxCell id="7" value="MAC address explanation: At Router A LAN capture point, the Ethernet destination MAC is Router A eth0 and the source MAC is PC1. On the WAN link, Router A rewrites Layer 2 addresses to Router A WAN MAC → Router B WAN MAC. The IP source/destination remain 64.56.0.2 → 10.20.0.2." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="640" width="1040" height="110" as="geometry" /></mxCell>

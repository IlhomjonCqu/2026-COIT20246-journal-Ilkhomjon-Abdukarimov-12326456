        <mxCell id="23" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" value="Byte Size Summary" vertex="1">
          <mxGeometry height="30" width="300" x="130" y="370" as="geometry" />
        </mxCell>
        <mxCell id="24" parent="1" style="text;html=1;strokeColor=#036897;fillColor=#dae8fc;align=left;verticalAlign=middle;whiteSpace=pre;rounded=4;fontSize=11;fontFamily=Courier New;spacingLeft=10;spacingTop=5;spacingBottom=5;" value="Field                                  Size (bytes)&#xa;────────────────────────────────────────────────&#xa;Ethernet Header (Dst + Src MAC + EtherType)   14&#xa;ARP Payload                                   28&#xa;  ↳  HTYPE + PTYPE + HLEN + PLEN + OPER       8&#xa;  ↳  SHA (Sender MAC)                         6&#xa;  ↳  SPA (Sender IP)                          4&#xa;  ↳  THA (Target MAC)                         6&#xa;  ↳  TPA (Target IP)                          4&#xa;Ethernet FCS (footer)                         4&#xa;────────────────────────────────────────────────&#xa;Total                                         46 bytes&#xa;(padded to 64 bytes minimum — 18 bytes padding)" vertex="1">
          <mxGeometry height="250" width="530" x="130" y="405" as="geometry" />
        </mxCell>
        <mxCell id="25" parent="1" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=4;fontSize=11;spacingLeft=8;" value="Note: This is an ARP &lt;b&gt;Request&lt;/b&gt; broadcast.&#xa;The Windows Host (192.168.56.1) does not know the MAC address&#xa;of the OpenWRT server (192.168.56.2), so it broadcasts &#39;Who has 192.168.56.2?&#39;&#xa;to all devices on the LAN (Dst MAC = FF:FF:FF:FF:FF:FF)." vertex="1">
          <mxGeometry height="120" width="430" x="700" y="405" as="geometry" />
        </mxCell>
        <mxCell id="26" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#666666;" value="Encapsulation direction" vertex="1">
          <mxGeometry height="30" width="200" x="700" y="545" as="geometry" />
        </mxCell>
        <mxCell id="27" edge="1" parent="1" style="endArrow=open;html=1;endFill=1;strokeColor=#666666;strokeWidth=1.5;dashed=1;" value="">
